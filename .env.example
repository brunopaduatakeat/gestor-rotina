# Google OAuth (nunca exponha no frontend)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-site.netlify.app/api/auth/callback

# Turso (libSQL) — banco serverless
# Formato real: libsql://nome-do-banco-usuario.turso.io
TURSO_DATABASE_URL=COLOQUE_AQUI_A_URL_DO_TURSO
TURSO_AUTH_TOKEN=COLOQUE_AQUI_O_TOKEN_DO_TURSO

# Web Push (VAPID) — gere com: node -e "require('web-push').generateVAPIDKeys()"  |  console.log(...)
VAPID_PUBLIC_KEY=COLOQUE_AQUI_A_CHAVE_PUBLICA_VAPID
VAPID_PRIVATE_KEY=COLOQUE_AQUI_A_CHAVE_PRIVADA_VAPID
VAPID_SUBJECT=mailto:seu@email.com

# JWT — autenticação de usuários (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=COLOQUE_AQUI_O_JWT_SECRET

# HubSpot (opcional — para seletor de usuários no cadastro)
HUBSPOT_PRIVATE_APP_TOKEN=COLOQUE_AQUI_O_TOKEN_DO_HUBSPOT

# Sentry (observabilidade — opcional)
VITE_SENTRY_DSN=COLOQUE_AQUI_O_DSN_DO_SENTRY
